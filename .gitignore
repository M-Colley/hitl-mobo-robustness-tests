# specific to these tests
.dataset_cache/
# output/ holds the old fitted sweep's run logs and the code-diff store
# (output/code_diffs/), which must stay ignored because a patch carries diff
# context. Only the small inputs of the paper's tables and checks are tracked:
# the noise anchor and calibration, the oracle selections, the per-dataset
# manifest (its sigma_f), and the pre-fix copies the archival estimates read.
# The per-dataset configs stay ignored; datasets*.json at the root hold the same.
output/*
!output/noise_anchor.csv
!output/noise_calibration.csv
!output/best_oracle_models.json
!output/best_oracle_models_postfix.json
!output/best_oracle_models_postfix_noaug.json
!output/best_oracle_models_postfix_mo.json
!output/per_dataset/
output/per_dataset/*
!output/per_dataset/manifest.json
!output/pre_fix_2026-09-23/
output/pre_fix_2026-09-23/*
!output/pre_fix_2026-09-23/best_oracle_models.json
!output/pre_fix_2026-09-23/noise_anchor.csv
!output/pre_fix_2026-09-23/noise_calibration.csv
!output/pre_fix_2026-09-23/per_dataset/
output/pre_fix_2026-09-23/per_dataset/*
!output/pre_fix_2026-09-23/per_dataset/manifest.json
output-chi/
# The main sweep's run logs (4.4 GB) stay out of the repository. One logged run
# of it reruns exactly with the current code, and its model-free floors only
# under the older acquisition order (scripts/check_provenance.py); its analysis
# outputs, which every
# table and figure in the paper is read from, are tracked, except the per-run
# replay caches and the largest per-run dumps, which the scripts rebuild.
# The per-landscape evaluation/paired_excess_metrics.csv files are table inputs
# and are tracked by force-adding them, since this pattern hides their parents.
# run_metadata.json stays ignored here: it records absolute local paths.
output-boba/*
!output-boba/analysis/
output-boba/analysis/**/per_run/
output-boba/analysis/stopping/cache_*/
output-boba/analysis/*.jsonl
output-boba/analysis/*.bak.csv
output-boba/analysis/**/*.parquet
# the onset bound's per-run table (3.8 MB) is the input of review_checks/mo_onset_bound.py
!output-boba/analysis/review/onset_bound_runs.parquet
output-boba/analysis/stopping/stopping_per_run.csv
output-boba/analysis/extra_runs_per_run.csv
output-boba/analysis/*.png
# The other arms whose run logs stay local. Their analysis directories (a few
# MB in all, diagnostic PNGs excepted) are table inputs and are tracked.
output-boba-extensions/*
!output-boba-extensions/analysis/
output-boba-extensions/analysis/*.png
output-boba-knownnoise/*
!output-boba-knownnoise/analysis/
output-boba-knownnoise/analysis/*.png
output-boba-incumbent/*
!output-boba-incumbent/analysis/
output-boba-incumbent/analysis/*.png
output-boba-stage3/
output-boba-ladder/*
!output-boba-ladder/analysis/
output-boba-ladder/analysis/*.png
output-boba-mo/*
!output-boba-mo/analysis/
output-boba-mo/analysis/*.png
output-boba-budget25/*
!output-boba-budget25/analysis/
output-boba-budget25/analysis/*.png
output-boba-budget100/*
!output-boba-budget100/analysis/
output-boba-budget100/analysis/*.png
output-fitted/*
!output-fitted/analysis/
output-fitted/analysis/*.png
output-fitted-noaug/
# pre-fix copies of the two arms above, kept locally for the before/after (2026-09-23)
output-fitted-prefix/
output-fitted-noaug-prefix/
output-boba-instrument/*
!output-boba-instrument/analysis/
output-boba-instrument/analysis/*.png
output-boba-robust/*
!output-boba-robust/analysis/
output-boba-robust/analysis/*.png
output-boba-confirmatory/*
!output-boba-confirmatory/HYPOTHESIS.md
!output-boba-confirmatory/analysis-sensitivity/

